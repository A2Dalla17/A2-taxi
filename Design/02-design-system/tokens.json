{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AC7 Ride design tokens. Mirrors frontend/tailwind.config.js — that file is authoritative. Regenerate this when it changes.",
  "$version": "1.0.0",

  "color": {
    "surface": {
      "background": { "$value": "#FFFFFF", "$type": "color", "$description": "Cards, sheets, inputs" },
      "secondary": { "$value": "#F5F5F7", "$type": "color", "$description": "Page canvas" },
      "card": { "$value": "#ECECEC", "$type": "color", "$description": "Flat panels, secondary buttons" }
    },

    "brand": {
      "50": { "$value": "#FBF2F5", "$type": "color" },
      "100": { "$value": "#F5DFE6", "$type": "color" },
      "200": { "$value": "#E9BECC", "$type": "color" },
      "300": { "$value": "#D993A9", "$type": "color" },
      "400": { "$value": "#C06582", "$type": "color" },
      "500": { "$value": "#A31B48", "$type": "color", "$description": "Hover" },
      "600": { "$value": "#8A1538", "$type": "color", "$description": "Primary" },
      "700": { "$value": "#6E102D", "$type": "color", "$description": "Pressed" },
      "800": { "$value": "#520C21", "$type": "color" },
      "900": { "$value": "#360816", "$type": "color" }
    },

    "text": {
      "primary": { "$value": "#1F1F1F", "$type": "color" },
      "muted": { "$value": "#6B7280", "$type": "color", "$description": "Minimum 14px — 4.83:1 contrast" },
      "subtle": { "$value": "#9CA3AF", "$type": "color", "$description": "Placeholders only" },
      "inverse": { "$value": "#FFFFFF", "$type": "color" }
    },

    "semantic": {
      "success": { "$value": "#10B981", "$type": "color" },
      "danger": { "$value": "#EF4444", "$type": "color" }
    },

    "border": {
      "default": { "$value": "#E5E5E7", "$type": "color" },
      "strong": { "$value": "#D1D1D6", "$type": "color" }
    },

    "chart": {
      "1": { "$value": "#8A1538", "$type": "color" },
      "2": { "$value": "#A31B48", "$type": "color" },
      "3": { "$value": "#C06582", "$type": "color" },
      "4": { "$value": "#D993A9", "$type": "color" },
      "5": { "$value": "#6B7280", "$type": "color" },
      "6": { "$value": "#9CA3AF", "$type": "color" }
    }
  },

  "typography": {
    "family": {
      "sans": { "$value": "Inter", "$type": "fontFamily" }
    },
    "scale": {
      "display": { "$value": { "fontSize": "56px", "fontWeight": 700, "lineHeight": 1.05, "letterSpacing": "-0.03em" }, "$type": "typography" },
      "h1": { "$value": { "fontSize": "40px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.025em" }, "$type": "typography" },
      "h2": { "$value": { "fontSize": "32px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$type": "typography" },
      "h3": { "$value": { "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "-0.015em" }, "$type": "typography" },
      "h4": { "$value": { "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "-0.01em" }, "$type": "typography" },
      "body": { "$value": { "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.6 }, "$type": "typography" },
      "bodySmall": { "$value": { "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.55 }, "$type": "typography" },
      "caption": { "$value": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5 }, "$type": "typography" },
      "micro": { "$value": { "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0.01em" }, "$type": "typography" }
    }
  },

  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "button": { "$value": "12px", "$type": "dimension" },
    "input": { "$value": "12px", "$type": "dimension" },
    "card": { "$value": "16px", "$type": "dimension" },
    "sheet": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },

  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },

  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(31,31,31,0.04)", "$type": "shadow" },
    "sm": { "$value": "0 1px 3px rgba(31,31,31,0.06), 0 1px 2px rgba(31,31,31,0.04)", "$type": "shadow" },
    "card": { "$value": "0 2px 8px rgba(31,31,31,0.05), 0 1px 3px rgba(31,31,31,0.04)", "$type": "shadow" },
    "lifted": { "$value": "0 8px 24px rgba(31,31,31,0.08), 0 2px 6px rgba(31,31,31,0.04)", "$type": "shadow" },
    "sheet": { "$value": "0 -8px 32px rgba(31,31,31,0.10)", "$type": "shadow" },
    "brand": { "$value": "0 4px 16px rgba(138,21,56,0.24)", "$type": "shadow" }
  },

  "motion": {
    "easing": {
      "smooth": { "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$type": "cubicBezier" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "content": { "$value": "280ms", "$type": "duration" },
      "sheet": { "$value": "320ms", "$type": "duration" }
    }
  },

  "size": {
    "touchTarget": { "$value": "44px", "$type": "dimension", "$description": "Minimum interactive area" },
    "control": {
      "sm": { "$value": "36px", "$type": "dimension" },
      "md": { "$value": "44px", "$type": "dimension" },
      "lg": { "$value": "56px", "$type": "dimension" }
    }
  },

  "breakpoint": {
    "mobile": { "$value": "390px", "$type": "dimension", "$description": "Design width; supports from 320px" },
    "tablet": { "$value": "834px", "$type": "dimension" },
    "desktop": { "$value": "1440px", "$type": "dimension", "$description": "Design width; supports from 1024px" }
  }
}
