# ============================================================================
# AC7 Ride — FRONTEND environment
# ----------------------------------------------------------------------------
# Copy to `.env.development.local` (git-ignored) and fill in.
# On Vercel, set the same keys under Settings → Environment Variables.
#
# IMPORTANT: every VITE_* value is bundled into the JavaScript that ships to
# the browser. Anyone can read them. Never put a secret here — no database
# password, no Stripe secret key, no JWT signing secret, no Supabase service
# role key. Those belong in the backend's own .env, which is never bundled.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — REQUIRED. Without these the app cannot read or write anything.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://lsxeernnmohrsjoqmyxo.supabase.co

# The publishable ("anon") key. Safe to expose: it identifies the project but
# authorises nothing by itself. Row level security decides what each request
# can see, and an unauthenticated caller can reach exactly two things — the
# active ride-type price list, and the driver code lookup.
VITE_SUPABASE_ANON_KEY=sb_publishable_9KV3HXBY4JQ9Gvb78eeNpw_IImCmKXC

# ---------------------------------------------------------------------------
# Control centre — the number on the landing page
# ---------------------------------------------------------------------------
VITE_CONTROL_CENTRE_TEL=+447833172989
VITE_CONTROL_CENTRE_DISPLAY=+44 7833 172989
VITE_CONTROL_CENTRE_HOURS=Open 24 hours, every day

# ---------------------------------------------------------------------------
# App store listings
# ---------------------------------------------------------------------------
# Leave BLANK until the apps are actually published. While these are empty the
# landing page offers the web app instead of linking to a store page that does
# not exist — a dead download button costs more trust than an honest one.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# ---------------------------------------------------------------------------
# London defaults
# ---------------------------------------------------------------------------
VITE_DEFAULT_MAP_LAT=51.5074
VITE_DEFAULT_MAP_LNG=-0.1278
VITE_DEFAULT_MAP_ZOOM=13
VITE_DEFAULT_CURRENCY=GBP
VITE_LOCALE=en-GB
VITE_PHONE_PREFIX=+44

# ---------------------------------------------------------------------------
# Design preview
# ---------------------------------------------------------------------------
# Serves screens from fixtures instead of the database, so the design can be
# reviewed on a phone before there is real data. Set to true ONLY on a preview
# deployment. Left unset, the whole preview module is dead code and the bundler
# removes it — verified by grepping the built bundle, not assumed.
VITE_PREVIEW_MODE=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Only needed if the Go services are put back in front of the app.
VITE_API_BASE_URL=

# Browser Maps key. The map works without one — CARTO tiles need no key — so
# leave this empty unless you specifically want Google's tiles.
VITE_GOOGLE_MAPS_BROWSER_KEY=
