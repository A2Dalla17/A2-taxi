node_modules/
dist/
.vite/
*.tsbuildinfo

# Package manager noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Build output — regenerated by CI and by Vercel on every deploy.
# Committing dist/ means every build produces a diff of minified noise.
# ---------------------------------------------------------------------------
frontend/dist/
backend/bin/
*.local
