*.sqlite3

# Secrets
# secrets
credentials.json
serviceAccount.json
config/jwt_keys.json

# Build artifacts
tmp/
temp/

# Generated runtime config only — the config/ directory itself is tracked.
# (Previously this was a blanket `/config`, which silently untracked
#  config/vault-policy.hcl during the restructure.)
config/jwt_keys.json
config/*.generated.*

# ---------------------------------------------------------------------------
# Frontend (Vite + React)
